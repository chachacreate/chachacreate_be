# 빌드 스테이지
FROM docker.io/library/gradle:8-jdk17 AS builder

WORKDIR /app

# Gradle 설정 파일들 먼저 복사
COPY build.gradle settings.gradle ./
COPY gradle ./gradle
COPY gradlew ./

# 의존성 다운로드
RUN gradle dependencies --no-daemon

# 소스코드 복사
COPY src ./src

# JAR 빌드
RUN gradle clean bootJar --no-daemon

# 실행 스테이지
FROM docker.io/library/eclipse-temurin:17-jre

MAINTAINER "chachacreate<kirk0221@naver.com>"

# 환경변수 설정
ENV TZ=Asia/Seoul

# 시간대 설정 및 필요한 패키지 설치
RUN apt-get update && apt-get install -y gettext-base && \
    ln -snf /usr/share/zoneinfo/Asia/Seoul /etc/localtime && \
    echo Asia/Seoul > /etc/timezone && \
    rm -rf /var/lib/apt/lists/*

# 빌드 스테이지에서 JAR 파일 복사
COPY --from=builder /app/build/libs/chachacreate-*.jar /app/app.jar

# 작업 디렉토리 설정
WORKDIR /app

# 시작 스크립트 생성
RUN echo '#!/bin/bash' > start.sh && \
    echo 'java -jar -Djava.security.egd=file:/dev/./urandom app.jar' >> start.sh && \
    chmod +x start.sh

EXPOSE 8080

CMD ["./start.sh"]